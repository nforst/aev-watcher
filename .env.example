# Es gibt keine Pflichtvariablen - ohne Konfiguration laeuft alles mit Defaults
# und die Nachrichten gehen an dein eigenes WhatsApp-Konto.

# Empfaenger. "self" (Default) = Nachricht an dich selbst.
# Andere Nummer international angeben, z. B. +4915112345678
# Gruppe: komplette Gruppen-ID, z. B. 120363000000000000@g.us
WHATSAPP_TO=self

# Ablageorte. Beide muessen auf einem persistenten Volume liegen,
# sonst ist nach jedem Deploy die WhatsApp-Kopplung weg.
STATE_FILE=/app/data/state.json
WA_AUTH_DIR=/app/data/wa-auth

# Pruefintervall in Sekunden (Minimum 30).
INTERVAL_SECONDS=300
# Obergrenze an Nachrichten pro Durchlauf; der Rest folgt im naechsten Lauf.
MAX_MESSAGES_PER_RUN=10
# true = auch beim allerersten Lauf ueber alle bereits gelisteten Anfragen benachrichtigen.
NOTIFY_ON_FIRST_RUN=false
