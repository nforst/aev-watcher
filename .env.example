# --- OpenWA Gateway (https://github.com/rmyndharis/OpenWA) ---
# Basis-URL deiner OpenWA-Instanz, ohne abschliessenden Slash.
OPENWA_BASE_URL=https://openwa.example.com
# API-Key aus dem OpenWA-Dashboard.
OPENWA_API_KEY=owa_k1_dein-api-key
# UUID der verbundenen Session (nicht der Session-Name).
OPENWA_SESSION_ID=8f3c2b1a-9d4e-4c7a-8b2f-1e6d5a4c3b2a

# Empfaenger. International mit Laendervorwahl; "@c.us" wird automatisch ergaenzt.
# Fuer eine Gruppe die komplette Gruppen-ID angeben, z. B. 1234567890-1234567890@g.us
WHATSAPP_TO=+4915112345678

# --- Verhalten (alle optional) ---
# Ablageort des Zustands. Muss auf einem persistenten Volume liegen.
STATE_FILE=/app/data/state.json
# Intervall fuer --watch in Sekunden (Minimum 30).
INTERVAL_SECONDS=300
# Obergrenze an Nachrichten pro Durchlauf; der Rest folgt im naechsten Lauf.
MAX_MESSAGES_PER_RUN=10
# true = auch beim allerersten Lauf ueber alle bereits gelisteten Anfragen benachrichtigen.
NOTIFY_ON_FIRST_RUN=false
