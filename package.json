{
  "name": "aev-watcher",
  "version": "1.0.0",
  "description": "Ueberwacht app-entwickler-verzeichnis.de auf neue Projektanfragen und benachrichtigt per WhatsApp (OpenWA)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "aev-watcher": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "watch": "node src/index.js --watch",
    "dry-run": "node src/index.js --dry-run",
    "test-message": "node src/index.js --test-message",
    "test": "node --test \"test/**/*.test.js\""
  }
}
